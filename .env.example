# API
PORT=3001
CORS_ORIGIN=http://localhost:3000
# App traffic: pooled Neon URL from `neon deploy` / `neon env pull` (or local Docker).
DATABASE_URL=postgresql://tiza:tiza@localhost:5432/tiza
# Migrations / drizzle-kit: direct Neon URL (no -pooler). Same as DATABASE_URL for local Docker.
# DATABASE_URL_UNPOOLED=
REDIS_URL=redis://localhost:6379
SESSION_SECRET=change-me-in-production-use-a-long-random-string
COOKIE_SECURE=false
# Set when the API sits behind a reverse proxy (e.g. 1 or hop count). Enables Express trust proxy.
# TRUST_PROXY=1

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001
